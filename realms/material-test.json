{
  "realm": "material",
  "enabled": true,
  "displayName": "Materialbibliothek (Test)",
  "displayNameHtml": "<span class=\"nna-kicker\">Test \u00b7 Materialbibliothek</span>NEB Network",
  "loginTheme": "nna",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "permanentLockout": false,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "de",
    "en"
  ],
  "defaultLocale": "de",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "offlineSessionIdleTimeout": 7776000,
  "smtpServer": {
    "host": "mail.nna-prod.svc.cluster.local",
    "port": "587",
    "from": "noreply-test@neb-network.app",
    "fromDisplayName": "Materialbibliothek (Test)",
    "replyTo": "",
    "auth": "true",
    "user": "keycloak-test@neb-network.app",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "User",
        "description": "Material library account"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-material",
        "composite": true,
        "composites": {
          "realm": [
            "User",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-material",
    "composite": true
  },
  "requiredActions": [
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "material-library",
      "name": "Materialbibliothek (Test)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://materialien.test.neb-network.app/*",
        "https://materialien-nigel.dev.neb-network.app/*",
        "https://materialien-siamak.dev.neb-network.app/*",
        "https://materialien-vitalina.dev.neb-network.app/*",
        "https://materialien-yigit.dev.neb-network.app/*",
        "https://materialien-hermann.dev.neb-network.app/*",
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "https://materialien.test.neb-network.app",
        "https://materialien-nigel.dev.neb-network.app",
        "https://materialien-siamak.dev.neb-network.app",
        "https://materialien-vitalina.dev.neb-network.app",
        "https://materialien-yigit.dev.neb-network.app",
        "https://materialien-hermann.dev.neb-network.app",
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "frontchannelLogout": true,
      "fullScopeAllowed": true
    }
  ],
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "DELETE_ACCOUNT",
    "VERIFY_EMAIL",
    "SEND_RESET_PASSWORD",
    "UPDATE_PASSWORD"
  ]
}
